# ==============================================================================
# PAWCIRCLE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env inside backend/ or workspace root.
# ==============================================================================

# 1. NEON POSTGRESQL (Serverless Postgres from neon.tech)
# Format: postgresql+asyncpg://<username>:<password>@<ep-pooler-id>.region.aws.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?ssl=require

# 2. HUGGING FACE INFERENCE API
# Generate from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_access_token_here
HF_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# 3. REDIS (Railway Redis, Upstash, or local)
REDIS_URL=redis://localhost:6379/0

# 4. SECURITY & AUTHENTICATION
JWT_SECRET=pawcircle_dev_secret_change_in_production_key_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 5. OBJECT STORAGE (Cloudflare R2 or AWS S3)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=pawcircle-documents
S3_REGION=auto

# 6. APP ENVIRONMENT & CORS
ENVIRONMENT=production
CORS_ORIGINS=["https://*.railway.app","https://*.up.railway.app","https://*.vercel.app","*"]

# 7. GOOGLE GEMINI AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_ID=gemini-3.1-flash-lite-preview

# 8. GOOGLE OAUTH & CALENDAR API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://<your-railway-backend-url>/api/v1/calendar/callback

# 9. SMTP EMAIL DISPATCH (Gmail App Password or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=supporthawpulse@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=supporthawpulse@gmail.com
EMAILS_FROM_NAME=HawPulse Team

# 10. REAL-TIME WEATHER API (WeatherAPI.com)
WEATHER_API_KEY=d47d0bdda08c4acf9a3100404261309

