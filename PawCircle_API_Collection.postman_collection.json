    {
      "name": "02. Authentication & Profiles",
      "item": [
        {
          "name": "1. Request OTP Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pooja@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "request-otp"
              ]
            },
            "description": "Generates and dispatches a 6-digit passwordless login code via Email (or logs to console in dev mode)."
          }
        },
        {
          "name": "2. Verify OTP & Obtain JWT (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('access_token', json.access_token);",
                  "        pm.environment.set('access_token', json.access_token);",
                  "        console.log('Saved access_token:', json.access_token);",
                  "    }",
                  "    if (json.user_id) {",
                  "        pm.collectionVariables.set('user_id', json.user_id);",
                  "        pm.environment.set('user_id', json.user_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pooja@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Validates 6-digit code (dev accepts 123456), auto-provisions profile in Neon PostgreSQL, and returns 30-day JWT Bearer token."
          }
        },
        {
          "name": "3. Google OAuth Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"SAMPLE_GOOGLE_ID_TOKEN\",\n  \"redirect_uri\": \"http://localhost:5173\"\n}"
            },
            "url": {
